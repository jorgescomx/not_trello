generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  boards    Board[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Board {
  id         String      @id @default(cuid())
  title      String
  color      String      @default("#026AA7")
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists      List[]
  swimlanes  Swimlane[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Swimlane {
  id        String   @id @default(cuid())
  title     String
  position  Float
  color     String   @default("#e0e7ff")
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model List {
  id        String   @id @default(cuid())
  title     String
  position  Float
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Card {
  id          String      @id @default(cuid())
  title       String
  description String?
  position    Float
  dueDate     DateTime?
  listId      String
  list        List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  swimlaneId  String?
  swimlane    Swimlane?   @relation(fields: [swimlaneId], references: [id], onDelete: SetNull)
  labels      CardLabel[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Label {
  id    String      @id @default(cuid())
  name  String
  color String
  cards CardLabel[]
}

model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}
